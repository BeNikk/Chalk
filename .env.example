# Settings for Chalk.
# `npm run setup` copies this file to `.env`, which is where your real settings live.
# `.env` is never committed (it's in .gitignore), so secrets stay on your machine.
#
# The values below work for local development as they are.
# You do NOT need any accounts or API keys to run Chalk on your laptop.

# ---------- App ----------

PORT=3000
# The address people open in the browser. Used to build links in emails.
APP_URL=http://localhost:3000

# A long random string used to sign login cookies. Change it in production.
SESSION_SECRET=change-me-to-something-long-and-random

# ---------- Database ----------

# Locally both point at the Docker database from docker-compose.yml.
# On Supabase they are different:
#   DATABASE_URL = the pooled connection string (port 6543, ends with ?pgbouncer=true), used by the app
#   DIRECT_URL   = the direct connection string (port 5432), used when creating tables
DATABASE_URL=postgres://chalk:chalk@localhost:5433/chalk
DIRECT_URL=postgres://chalk:chalk@localhost:5433/chalk

# ---------- Admin ----------

# Whoever signs up and verifies with this email becomes the admin, who can assign moderators.
# Leave empty locally; the seed script creates a test admin for you.
ADMIN_EMAIL=

# ---------- Email (Resend) ----------

# Leave empty locally: emails are printed in the terminal instead of being sent.
RESEND_API_KEY=
# The "from" address. Its domain must be verified in Resend.
EMAIL_FROM=Chalk <hello@biznudge.in>

# ---------- Profile photos (Cloudinary) ----------

# Leave empty locally: photos are saved in the uploads/ folder instead.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
