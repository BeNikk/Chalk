# Settings for `npm test`. Safe to commit: it only points at the local test database.
# Tests delete all data in this database before each test, so it must never be your real one.
NODE_ENV=test
DATABASE_URL=postgres://chalk:chalk@localhost:5433/chalk_test
DIRECT_URL=postgres://chalk:chalk@localhost:5433/chalk_test
SESSION_SECRET=test-secret
APP_URL=http://localhost:3000
ADMIN_EMAIL=admin@test.chalk
# Empty on purpose: tests save photos to uploads/, never to Cloudinary.
CLOUDINARY_URL=
