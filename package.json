{
  "name": "chalk",
  "version": "0.1.0",
  "private": true,
  "description": "A campus writing space: write, like, comment and share under a handle you choose.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "start": "node server/index.js",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prisma": "^7.10.1"
  }
}
