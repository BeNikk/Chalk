{
  "name": "chalk",
  "version": "0.1.0",
  "private": true,
  "description": "A campus writing space: write, like, comment and share under a handle you choose.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "start": "node server/index.js",
    "lint": "eslint . && node scripts/check-themes.js",
    "postinstall": "prisma generate",
    "db:update": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test": "node scripts/test.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@quixo3/prisma-session-store": "^3.1.21",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "multer": "^2.5.0",
    "resend": "^6.38.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2"
  }
}
